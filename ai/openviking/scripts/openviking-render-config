#!/usr/bin/env bash
set -euo pipefail

openviking_home="${OPENVIKING_HOME:-$HOME/.openviking}"
env_template="$openviking_home/env.tpl"
config_template="$openviking_home/ov.conf.tpl"
env_file="$openviking_home/.env"
config_file="$openviking_home/ov.conf"

mkdir -p "$openviking_home" "$HOME/.local/share/openviking"

op inject -f -i "$env_template" -o "$env_file"
chmod 600 "$env_file"

set -a
# shellcheck source=/dev/null
source "$env_file"
set +a

# op inject exits 0 and writes an empty value when a referenced field is missing
# or blank, so check before rendering — otherwise ov.conf silently gets an empty
# api_key and the provider fails auth at runtime instead of here.
missing=()
while IFS='=' read -r name _; do
  case "$name" in ''|\#*) continue ;; esac
  [ -n "${!name:-}" ] || missing+=("$name")
done < "$env_file"
if [ ${#missing[@]} -gt 0 ]; then
  printf 'ERROR: empty secret(s), refusing to render %s: %s\n' \
    "$config_file" "${missing[*]}" >&2
  exit 1
fi

envsubst < "$config_template" > "$config_file"
chmod 600 "$config_file"

jq empty "$config_file"
echo "Rendered $config_file"
