{
  "fileSuggestion": {
    "type": "command",
    "command": "~/.claude/file-suggestion.sh"
  },
  "env": {
    "API_TIMEOUT_MS": "3000000",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git show-branch:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(jq:*)",
      "Bash(ast-grep:*)",
      "Bash(docker compose logs:*)",
      "Bash(awk:*)",
      "Bash(sqlite3:*)",
      "mcp__plugin_openviking-memory_openviking__health",
      "mcp__plugin_openviking-memory_openviking__find",
      "mcp__plugin_openviking-memory_openviking__search",
      "mcp__plugin_openviking-memory_openviking__read",
      "mcp__plugin_openviking-memory_openviking__list",
      "mcp__plugin_openviking-memory_openviking__grep",
      "mcp__plugin_openviking-memory_openviking__glob",
      "mcp__plugin_openviking-memory_openviking__code_outline",
      "mcp__plugin_openviking-memory_openviking__code_search",
      "mcp__plugin_openviking-memory_openviking__code_expand"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "skillOverrides": {
    "template": "off",
    "frontend-design": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/carlos/go/bin/snip hook"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); model_name=$(echo \"$input\" | jq -r '.model.display_name'); current_dir=$(echo \"$input\" | jq -r '.workspace.current_dir'); project_dir=$(echo \"$input\" | jq -r '.workspace.project_dir'); output_style=$(echo \"$input\" | jq -r '.output_style.name'); version=$(echo \"$input\" | jq -r '.version'); git_branch=$(cd \"$current_dir\" 2>/dev/null && git branch --show-current 2>/dev/null); git_status=$(cd \"$current_dir\" 2>/dev/null && git status --porcelain 2>/dev/null | wc -l); pwd_display=$(echo \"$current_dir\" | sed \"s|^$HOME|~|\"); printf \"\\033[2m\\033[38;2;116;199;236m\\033[0m \\033[2m\\033[1m\\033[38;2;203;166;247m%s\\033[0m\" \"$model_name\"; printf \" \\033[2m\\033[38;2;180;190;254m%s\\033[0m\" \"$pwd_display\"; if [ -n \"$git_branch\" ]; then printf \" \\033[2m\\033[38;2;203;166;247m\\033[0m \\033[2m\\033[1m\\033[38;2;203;166;247m%s\\033[0m\" \"$git_branch\"; if [ \"$git_status\" -gt 0 ]; then printf \" \\033[2m\\033[38;2;249;226;175m+%s\\033[0m\" \"$git_status\"; fi; fi; if [ \"$output_style\" != \"default\" ]; then printf \" \\033[2m\\033[38;2;148;226;213m%s\\033[0m\" \"$output_style\"; fi; printf \" \\033[2m\\033[38;2;166;173;200mv%s\\033[0m\" \"$version\""
  },
  "enabledPlugins": {
    "claude-code-memory-plugin@openviking-plugins-local": true,
    "claude-code-setup@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "csharp-lsp@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": true,
    "okf-local@carlos-local": true
  },
  "extraKnownMarketplaces": {
    "openviking-plugins-local": {
      "source": {
        "source": "directory",
        "path": "/home/carlos/.openviking/openviking-repo/examples"
      }
    },
    "carlos-local": {
      "source": {
        "source": "directory",
        "path": "/home/carlos/.dotfiles/ai"
      }
    }
  },
  "effortLevel": "xhigh",
  "advisorModel": "fable",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": false,
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "pluginConfigs": {
    "okf-local@carlos-local": {
      "options": {
        "uv_executable": "/usr/bin/uv",
        "mcp_project_root": "/home/carlos/Development/ITERAMIND/projects/okf-mcp",
        "repository_root": "/home/carlos/Development/ITERAMIND"
      }
    }
  }
}
