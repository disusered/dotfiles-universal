#!/usr/bin/env bash
set -euo pipefail

port="${PORT:-43110}"
url="http://127.0.0.1:${port}/"
timeout_seconds="${BRAIN_WEB_SMOKE_TIMEOUT_SECONDS:-30}"
deadline=$((SECONDS + timeout_seconds))
brain_web_request_timeout_seconds=5

trim_text() {
  local value="${1-}"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

first_text() {
  local candidate
  for candidate in "$@"; do
    candidate="$(trim_text "$candidate")"
    if [[ -n "$candidate" ]]; then
      printf '%s' "$candidate"
      return
    fi
  done
  return 0
}

openviking_config="$(trim_text "${OPENVIKING_CLI_CONFIG_FILE:-}")"
home_prefix='~'
if [[ -z "$openviking_config" ]]; then
  openviking_config="$HOME/.openviking/ovcli.conf"
elif [[ "$openviking_config" == "~" ]]; then
  openviking_config="$HOME"
elif [[ "${openviking_config:0:2}" == "$home_prefix/" ]]; then
  openviking_config="$HOME/${openviking_config:2}"
fi

command -v jq >/dev/null

openviking_cli='{}'
if [[ -e "$openviking_config" ]]; then
  test -r "$openviking_config"
  openviking_cli="$(
    jq -ce '
      if type != "object" then
        error("OpenViking CLI config must be a JSON object")
      else
        .
      end
      | reduce ["url", "api_key", "account", "user", "actor_peer_id", "peer_id", "agent_id"][] as $key (.;
          if has($key) and (.[$key] | type) != "string" then
            error("OpenViking CLI config field " + $key + " must be a string")
          else
            .
          end
        )
      | if has("timeout") and ((.timeout | type) != "number" or (.timeout | isfinite | not)) then
          error("OpenViking CLI config field timeout must be a finite number")
        else
          .
        end
    ' "$openviking_config"
  )"
fi

cli_url="$(jq -r '.url // ""' <<<"$openviking_cli")"
cli_api_key="$(jq -r '.api_key // ""' <<<"$openviking_cli")"
cli_account="$(jq -r '.account // ""' <<<"$openviking_cli")"
cli_user="$(jq -r '.user // ""' <<<"$openviking_cli")"
cli_actor_peer_id="$(jq -r '.actor_peer_id // ""' <<<"$openviking_cli")"
cli_peer_id="$(jq -r '.peer_id // ""' <<<"$openviking_cli")"
cli_agent_id="$(jq -r '.agent_id // ""' <<<"$openviking_cli")"
cli_timeout="$(jq -r 'if has("timeout") then .timeout else "" end' <<<"$openviking_cli")"

openviking_url="$(first_text "${OPENVIKING_URL:-}" "${OPENVIKING_BASE_URL:-}" "$cli_url" "http://127.0.0.1:1933")"
openviking_url="${openviking_url%/}"
openviking_api_key="$(first_text "${OPENVIKING_API_KEY:-}" "${OPENVIKING_BEARER_TOKEN:-}" "$cli_api_key")"
openviking_account="$(first_text "${OPENVIKING_ACCOUNT:-}" "$cli_account")"
openviking_user="$(first_text "${OPENVIKING_USER:-}" "$cli_user")"
openviking_peer_id="$(first_text \
  "${OPENVIKING_PEER_ID:-}" \
  "${OPENVIKING_ACTOR_PEER_ID:-}" \
  "$cli_actor_peer_id" \
  "$cli_peer_id" \
  "$cli_agent_id")"

if [[ -z "$openviking_account" || -z "$openviking_user" ]]; then
  echo "OpenViking identity is missing; configure account and user in $openviking_config or OPENVIKING_ACCOUNT/OPENVIKING_USER" >&2
  exit 1
fi

openviking_timeout_ms="$(
  jq -nr \
    --arg timeout_ms "$(trim_text "${OPENVIKING_TIMEOUT_MS:-}")" \
    --arg timeout_seconds "$(trim_text "${OPENVIKING_TIMEOUT:-}")" \
    --arg cli_timeout "$cli_timeout" '
      def number_or_null($value):
        if $value == "" then null else (try ($value | tonumber) catch null) end;
      [
        number_or_null($timeout_ms),
        (number_or_null($timeout_seconds) | if . == null then null else . * 1000 end),
        (number_or_null($cli_timeout) | if . == null then null else . * 1000 end),
        30000
      ]
      | map(select(. != null and isfinite))
      | .[0]
      | floor
      | if . < 1000 then 1000 else . end
    '
)"
openviking_timeout_seconds="$(jq -nr --argjson timeout_ms "$openviking_timeout_ms" '$timeout_ms / 1000')"

openviking_headers=(
  -H 'Content-Type: application/json'
  -H "X-OpenViking-Account: $openviking_account"
  -H "X-OpenViking-User: $openviking_user"
)
if [[ -n "$openviking_api_key" ]]; then
  openviking_headers+=(
    -H "Authorization: Bearer $openviking_api_key"
    -H "X-API-Key: $openviking_api_key"
  )
fi
if [[ -n "$openviking_peer_id" ]]; then
  openviking_headers+=(-H "X-OpenViking-Actor-Peer: $openviking_peer_id")
fi

curl_openviking() {
  curl -fsS --max-time "$openviking_timeout_seconds" "${openviking_headers[@]}" "$@"
}

systemctl --user is-active --quiet brain-web.service
systemctl --user is-active --quiet openviking.service

until curl -fsS --max-time "$brain_web_request_timeout_seconds" -o /dev/null "$url" 2>/dev/null; do
  if (( SECONDS >= deadline )); then
    curl -fsS --max-time "$brain_web_request_timeout_seconds" -o /dev/null "$url"
  fi
  sleep 1
done

curl_openviking "$openviking_url/health" |
  jq -e '.status == "ok" and .healthy == true and (.version | type == "string")' >/dev/null

curl_openviking "$openviking_url/ready" |
  jq -e '
    .status == "ready" and
    .checks.agfs == "ok" and
    .checks.vectordb == "ok" and
    .checks.embedding == "ok"
  ' >/dev/null

curl_openviking "$openviking_url/api/v1/system/status" |
  jq -e --arg user "$openviking_user" '
    .status == "ok" and
    .result.initialized == true and
    .result.user == $user
  ' >/dev/null

search_payload="$(
  jq -nc \
    --arg query "brain web deployment smoke" \
    --arg uri "viking://user/memories" \
    '{query: $query, target_uri: $uri, limit: 1, score_threshold: 0}'
)"

curl_openviking \
  --data "$search_payload" \
  "$openviking_url/api/v1/search/search" |
  jq -e --arg prefix "viking://user/$openviking_user/" '
    .status == "ok" and
    (.result.memories | type == "array") and
    all(.result.memories[]; (.uri | type == "string") and (.uri | startswith($prefix)))
  ' >/dev/null

echo "Brain Web and OpenViking are responding with the canonical user config"
