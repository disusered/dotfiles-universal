#!/usr/bin/env bash
set -euo pipefail

app_dir="${BRAIN_WEB_APP_DIR:-/home/carlos/Development/ME/herding-cats/workshop/spikes/pi-brain-web}"

export PATH="/home/carlos/.local/bin:/home/carlos/.cargo/bin:$PATH"
if [ -x /home/carlos/.local/bin/mise ]; then
  eval "$(/home/carlos/.local/bin/mise activate bash)"
fi

cd "$app_dir"

if [ -f package-lock.json ]; then
  npm ci
else
  npm install
fi
npm run build

systemctl --user daemon-reload
systemctl --user enable brain-web.service
systemctl --user restart brain-web.service
env \
  -u OPENVIKING_CLI_CONFIG_FILE \
  -u OPENVIKING_URL \
  -u OPENVIKING_BASE_URL \
  -u OPENVIKING_API_KEY \
  -u OPENVIKING_BEARER_TOKEN \
  -u OPENVIKING_ACCOUNT \
  -u OPENVIKING_USER \
  -u OPENVIKING_PEER_ID \
  -u OPENVIKING_ACTOR_PEER_ID \
  -u OPENVIKING_TIMEOUT_MS \
  -u OPENVIKING_TIMEOUT \
  brain-web-smoke
