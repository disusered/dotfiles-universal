[Unit]
Description=Brain Portal MCP server (day tools and the Polychrome knowledge Bundle)
After=network-online.target brain-portal.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Development/ME/herding-cats/projects/brain-portal/apps/mcp
Environment=NODE_ENV=production
ExecStart=%h/.local/bin/mise exec node@24 -- node dist/bin.js --http --port 1937 --allowed-host brain-mcp.disusered.com --polychrome-root %h/Development/ME/herding-cats
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
UMask=0077

LockPersonality=true
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ProtectHome=read-only
# Saves write the Polychrome Bundle; maintenance regenerates its index, log and view.
ReadWritePaths=%h/Development/ME/herding-cats/polychrome
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=default.target
