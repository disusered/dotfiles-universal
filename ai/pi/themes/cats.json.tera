{
	"$schema": "https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",
	"name": "cats",
	"appearance": "{% if flavor == "latte" %}light{% else %}dark{% endif %}",
	"vars": {
		"page": "#{{ base | hex }}",
		"surface": "#{{ mantle | hex }}",
		"raised": "#{{ surface0 | hex }}",
		"text": "#{{ text | hex }}",
		"muted": "#{{ subtext0 | hex }}",
		"dim": "#{{ overlay2 | hex }}",
		"faint": "#{{ overlay0 | hex }}",
		"border": "#{{ surface1 | hex }}",
		"borderSoft": "#{{ surface0 | hex }}",
		"accent": "#{{ primary | hex }}",
		"secondary": "#{{ secondary | hex }}",
		"lavender": "#{{ lavender | hex }}",
		"success": "#{{ green | hex }}",
		"warning": "#{{ yellow | hex }}",
		"danger": "#{{ red | hex }}",
		"info": "#{{ blue | hex }}",
		"peach": "#{{ peach | hex }}",
		"teal": "#{{ teal | hex }}",
		"sky": "#{{ sky | hex }}",
		"successBg": "#{{ green | blend(base=base, amount=16) | hex }}",
		"dangerBg": "#{{ red | blend(base=base, amount=16) | hex }}",
		"warningBg": "#{{ yellow | blend(base=base, amount=16) | hex }}"
	},
	"colors": {
		"accent": "accent",
		"border": "dim",
		"borderAccent": "accent",
		"borderMuted": "border",
		"success": "success",
		"error": "danger",
		"warning": "warning",
		"muted": "muted",
		"dim": "dim",
		"text": "text",
		"thinkingText": "muted",
		"selectedBg": "raised",
		"scrollbarTrack": "borderSoft",
		"scrollbarThumb": "dim",
		"searchMatchBg": "warningBg",
		"searchMatchText": "text",
		"userMessageBg": "raised",
		"userMessageText": "text",
		"customMessageBg": "surface",
		"customMessageText": "muted",
		"customMessageLabel": "accent",
		"toolPendingBg": "surface",
		"toolSuccessBg": "successBg",
		"toolErrorBg": "dangerBg",
		"toolTitle": "text",
		"toolOutput": "muted",
		"mdHeading": "accent",
		"mdLink": "info",
		"mdLinkUrl": "dim",
		"mdCode": "peach",
		"mdCodeBlock": "teal",
		"mdCodeBlockBorder": "border",
		"mdQuote": "muted",
		"mdQuoteBorder": "border",
		"mdHr": "border",
		"mdListBullet": "accent",
		"toolDiffAdded": "success",
		"toolDiffRemoved": "danger",
		"toolDiffContext": "muted",
		"syntaxComment": "dim",
		"syntaxKeyword": "accent",
		"syntaxFunction": "info",
		"syntaxVariable": "text",
		"syntaxString": "success",
		"syntaxNumber": "peach",
		"syntaxType": "warning",
		"syntaxOperator": "sky",
		"syntaxPunctuation": "muted",
		"thinkingOff": "faint",
		"thinkingMinimal": "dim",
		"thinkingLow": "info",
		"thinkingMedium": "lavender",
		"thinkingHigh": "accent",
		"thinkingXhigh": "secondary",
		"thinkingMax": "peach",
		"bashMode": "success"
	},
	"export": {
		"pageBg": "page",
		"cardBg": "surface",
		"infoBg": "raised"
	}
}
