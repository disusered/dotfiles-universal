export PAGER='less'

# ZSH environment variable for temporary files
export TMPDIR="/tmp"

# Keep Python bytecode caches out of source trees; they are mirrored under the
# user cache directory instead of being written next to the source files.
export PYTHONPYCACHEPREFIX="${XDG_CACHE_HOME:-$HOME/.cache}/python"

# Locale settings
export LANG='en_US.UTF-8'
export LC_ALL='en_US.UTF-8'
export LC_CTYPE='en_US.UTF-8'
export LC_NUMERIC='en_US.UTF-8'
export LC_TIME='en_US.UTF-8'
export LC_COLLATE='en_US.UTF-8'
export LC_MONETARY='en_US.UTF-8'
export LC_MESSAGES='en_US.UTF-8'
# User bins. Kept here, not in .zshrc, because SDDM starts the Hyprland
# session through a login shell: anything the compositor spawns inherits it.
export PATH="$HOME/.local/bin:$PATH"
. "$HOME/.cargo/env"
