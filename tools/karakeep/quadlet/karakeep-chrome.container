[Unit]
Description=Karakeep browser crawler

[Container]
ContainerName=karakeep-chrome
Image=ghcr.io/karakeep-app/karakeep-chrome@sha256:5b19bbb160e9ff60681a3abd97e1c4ec9f64212301410de658c3900ab7ef31e7
Pull=missing
Network=karakeep.network
NetworkAlias=chrome
Exec=--disable-gpu --disable-dev-shm-usage --hide-scrollbars --disable-blink-features=AutomationControlled --window-size=1440,900
RunInit=true
NoNewPrivileges=true

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=900
