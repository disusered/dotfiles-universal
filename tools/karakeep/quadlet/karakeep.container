[Unit]
Description=Karakeep capture and reading library
Requires=karakeep-chrome.service karakeep-search.service
After=karakeep-chrome.service karakeep-search.service

[Container]
ContainerName=karakeep
Image=ghcr.io/karakeep-app/karakeep:0.33.2
Pull=missing
Network=karakeep.network
PublishPort=127.0.0.1:43130:3000
EnvironmentFile=%h/.config/karakeep/server.env
EnvironmentFile=%h/.config/karakeep/inference.env
Volume=%h/.local/share/karakeep/data:/data
NoNewPrivileges=true

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=900

[Install]
WantedBy=default.target
