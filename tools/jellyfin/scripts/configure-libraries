#!/usr/bin/env python3
"""Apply the repository's library declarations through the local Jellyfin API."""

import argparse
import json
from pathlib import Path
import subprocess
import sys
from urllib.error import HTTPError, URLError
from urllib.parse import urlencode
from urllib.request import Request, urlopen


CONFIG = Path(__file__).resolve().parents[1] / "libraries.json"
SERVER = "http://127.0.0.1:8096"


class SetupError(Exception):
    pass


class Jellyfin:
    def __init__(self):
        self.token = None

    def request(self, method, path, body=None):
        headers = {
            "Accept": "application/json",
            "Authorization": 'MediaBrowser Client="Dotfiles", Device="work", '
            'DeviceId="dotfiles-jellyfin-libraries", Version="1.0"',
        }
        if self.token:
            headers["Authorization"] += f', Token="{self.token}"'
        data = None
        if body is not None:
            headers["Content-Type"] = "application/json"
            data = json.dumps(body).encode()
        try:
            with urlopen(Request(SERVER + path, data=data, headers=headers, method=method), timeout=30) as response:
                payload = response.read()
                return json.loads(payload) if payload else None
        except HTTPError as error:
            raise SetupError(f"Jellyfin {method} {path}: HTTP {error.code}") from None
        except URLError as error:
            raise SetupError(f"Cannot reach local Jellyfin: {error.reason}") from None

    def authenticate(self, item, vault):
        command = ["op", "item", "get", item, "--format", "json", "--reveal"]
        if vault:
            command.extend(["--vault", vault])
        result = subprocess.run(command, capture_output=True, text=True, check=False)
        if result.returncode:
            raise SetupError(f"1Password lookup failed (exit {result.returncode}); check the item and vault.")
        fields = {field["id"]: field.get("value", "") for field in json.loads(result.stdout)["fields"]}
        if not fields.get("username") or not fields.get("password"):
            raise SetupError("The 1Password login needs username and password fields.")
        auth = self.request("POST", "/Users/AuthenticateByName", {
            "Username": fields["username"], "Pw": fields["password"],
        })
        self.token = auth["AccessToken"]
        if not auth["User"]["Policy"]["IsAdministrator"]:
            raise SetupError("Library setup requires a Jellyfin administrator login.")


def plan_libraries(desired, existing):
    actions = []
    for library in desired:
        name = library["Name"]
        paths = library["Locations"]
        for path in paths:
            if not Path(path).is_dir():
                raise SetupError(f"Media directory is missing or inaccessible: {path}")
        matches = [entry for entry in existing if entry["Name"].casefold() == name.casefold()]
        if len(matches) > 1:
            raise SetupError(f"Multiple existing libraries match {name}.")
        if not matches:
            if any(path in entry.get("Locations", []) for entry in existing for path in paths):
                raise SetupError(f"A folder for {name} already belongs to another library; review it in Jellyfin.")
            actions.append(("create", library, None))
            continue
        current = matches[0]
        if current.get("CollectionType") != library["CollectionType"]:
            raise SetupError(f"Existing {name} has a different content type; review it in Jellyfin.")
        missing = [path for path in paths if path not in current.get("Locations", [])]
        for path in missing:
            actions.append(("add_path", current, path))
        if not missing:
            print(f"Ready: {name} ({library['CollectionType']}) → {', '.join(paths)}")
    return actions


def library_options(api, library, defaults):
    query = urlencode({"libraryContentType": library["CollectionType"], "isNewLibrary": "true"})
    available = api.request("GET", "/Libraries/AvailableOptions?" + query)
    types = []
    for entry in available["TypeOptions"]:
        options = {"Type": entry["Type"], "ImageOptions": entry["DefaultImageOptions"]}
        for kind in ("MetadataFetchers", "ImageFetchers", "SimilarItemProviders"):
            options[kind] = [provider["Name"] for provider in entry[kind] if provider["DefaultEnabled"]]
        types.append(options)
    return {
        **defaults,
        "PathInfos": [{"Path": path} for path in library["Locations"]],
        "TypeOptions": types,
    }


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--apply", action="store_true", help="Apply changes; otherwise only show the plan")
    parser.add_argument("--op-item", help="1Password login item name or ID, required after the setup wizard")
    parser.add_argument("--op-vault", help="Vault containing the 1Password login")
    args = parser.parse_args()
    config = json.loads(CONFIG.read_text())
    api = Jellyfin()
    try:
        if api.request("GET", "/System/Info/Public")["StartupWizardCompleted"]:
            if not args.op_item:
                raise SetupError("Supply --op-item with the administrator's 1Password login item.")
            api.authenticate(args.op_item, args.op_vault)
        desired = config["Libraries"]
        existing = api.request("GET", "/Library/VirtualFolders")
        actions = plan_libraries(desired, existing)
        for index, (action, library, path) in enumerate(actions):
            print(f"{'Applying' if args.apply else 'Would apply'}: {action} {library['Name']} {path or library['Locations']}", flush=True)
            if not args.apply:
                continue
            refresh = "true" if index == len(actions) - 1 else "false"
            if action == "create":
                query = urlencode({
                    "name": library["Name"], "collectionType": library["CollectionType"], "refreshLibrary": refresh,
                })
                api.request("POST", "/Library/VirtualFolders?" + query, {
                    "LibraryOptions": library_options(api, library, config["LibraryOptions"]),
                })
            else:
                api.request("POST", "/Library/VirtualFolders/Paths?refreshLibrary=" + refresh, {
                    "Name": library["Name"], "Path": path,
                })
        if args.apply:
            if plan_libraries(desired, api.request("GET", "/Library/VirtualFolders")):
                raise SetupError("Jellyfin did not retain all declared library folders.")
            print("All declared libraries verified.")
    finally:
        if api.token:
            api.request("POST", "/Sessions/Logout")


if __name__ == "__main__":
    try:
        main()
    except (SetupError, OSError, ValueError, KeyError) as error:
        print(f"Library setup failed: {error}", file=sys.stderr)
        sys.exit(1)
