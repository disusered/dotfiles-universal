#!/usr/bin/env bash
set -euo pipefail

set -a
. "$HOME/.config/neo4j/neo4j.env"
set +a

systemctl --user is-active --quiet neo4j.service
password="${NEO4J_AUTH#*/}"
podman exec neo4j cypher-shell -u neo4j -p "$password" "RETURN 1 AS ok;"
curl -fsS -o /dev/null http://127.0.0.1:7474

echo "Neo4j is responding on Bolt and HTTP loopback ports"
