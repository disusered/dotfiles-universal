	reverse_proxy 127.0.0.1:8789
}

jellyfin.disusered.com {
	bind {$CADDY_TAILSCALE_IP}
	import disusered_tls
	reverse_proxy 127.0.0.1:8096
}

# Cloudflare Tunnel reaches this loopback-only public document reader.
# All private Portal routes and assets stay behind the tailnet listener.
http://:43111 {
	bind 127.0.0.1
	@share {
		host share.disusered.com
		path_regexp share ^/s/[A-Za-z0-9_-]{16,64}(/opengraph-image)?/?$
	}
	handle @share {
		@write not method GET HEAD
		header @write Allow "GET, HEAD"
		respond @write 405
		reverse_proxy 127.0.0.1:43110
	}
	handle {
		respond 404
	}
}
