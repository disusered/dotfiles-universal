{
	admin off
}

(disusered_tls) {
	tls /var/lib/caddy/tls/disusered.com/fullchain.pem /var/lib/caddy/tls/disusered.com/privkey.pem
}

opencode.disusered.com {
	bind {$CADDY_TAILSCALE_IP}
	import disusered_tls
	reverse_proxy 127.0.0.1:3014 {
		flush_interval -1
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		transport http {
			read_timeout 3600s
			write_timeout 3600s
		}
	}
}

search.disusered.com {
	bind {$CADDY_TAILSCALE_IP}
	import disusered_tls
	reverse_proxy localhost:47123
}

romm.disusered.com {
	bind {$CADDY_TAILSCALE_IP}
	import disusered_tls
	reverse_proxy localhost:47224
}

xbol.disusered.com {
	bind {$CADDY_TAILSCALE_IP}
	import disusered_tls
	reverse_proxy localhost:43000
}

brain.disusered.com {
	bind {$CADDY_TAILSCALE_IP}
	import disusered_tls
	reverse_proxy 127.0.0.1:43110
}

harness.disusered.com {
	bind {$CADDY_TAILSCALE_IP}
	import disusered_tls
	reverse_proxy 127.0.0.1:43120 {
		flush_interval -1
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		transport http {
			read_timeout 3600s
			write_timeout 3600s
		}
	}
}
