#:schema https://docs.jj-vcs.dev/latest/config-schema.json

[user]
name = "Carlos Rosquillas"
email = "crosquillas@gmail.com"

[ui]
color = "auto"
editor = "nvim"
pager = ":builtin"
diff-formatter = ":color-words"
diff-editor = ":builtin"
merge-editor = "nvim"

[git]
colocate = true
sign-on-push = true

[working-copy]
eol-conversion = "input"

[fsmonitor]
backend = "watchman"

[signing]
behavior = "own"
backend = "ssh"
key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIN0ymLThQeG/B8GhYqrOUdjr2yydERDzP94yU9LT9o+N"
backends.ssh.allowed-signers = "~/.ssh/allowed_signers"

[merge-tools.nvim]
program = "nvim"
merge-args = ["-f", "$output"]
merge-tool-edits-conflict-markers = true
conflict-marker-style = "git"

[template-aliases]
'format_starship(commit, stats)' = '''
separate(
  " ",
  label("jj", "jj"),
  label("change_id", commit.change_id().shortest(4)),
  commit.bookmarks(),
  if(
    stats.total_added() > 0,
    label("diff added", "+" ++ stats.total_added()),
  ),
  if(
    stats.total_removed() > 0,
    label("diff removed", "-" ++ stats.total_removed()),
  ),
  if(commit.conflict(), label("conflict", "conflict")),
  if(commit.divergent(), label("divergent", "divergent")),
  if(commit.empty(), label("empty", "empty")),
)
'''

[colors]
jj = { fg = "#{{ primary | hex }}", bold = true }
change_id = "#{{ primary | hex }}"
commit_id = "#{{ secondary | hex }}"
author = "#{{ yellow | hex }}"
timestamp = "#{{ teal | hex }}"
bookmark = "#{{ primary | hex }}"
bookmarks = "#{{ primary | hex }}"
local_bookmarks = "#{{ primary | hex }}"
remote_bookmarks = "#{{ blue | hex }}"
tag = "#{{ peach | hex }}"
tags = "#{{ peach | hex }}"
git_ref = "#{{ green | hex }}"
git_refs = "#{{ green | hex }}"
working_copies = "#{{ green | hex }}"
divergent = "#{{ maroon | hex }}"
"mutable divergent" = { fg = "#{{ red | hex }}", bold = true }
conflict = { fg = "#{{ red | hex }}", bold = true }
empty = "#{{ green | hex }}"
separator = "#{{ overlay0 | hex }}"
elided = "#{{ overlay0 | hex }}"
rest = "#{{ overlay0 | hex }}"
"node working_copy" = { fg = "#{{ green | hex }}", bold = true }
"node immutable" = { fg = "#{{ sapphire | hex }}", bold = true }
"node conflicted" = { fg = "#{{ red | hex }}", bold = true }
"diff removed" = { fg = "#{{ red | hex }}" }
"diff added" = { fg = "#{{ green | hex }}" }
"diff removed token" = { bg = "#{{ red | blend(base=base, amount=25) | hex }}", bold = true, underline = false }
"diff added token" = { bg = "#{{ green | blend(base=base, amount=25) | hex }}", bold = true, underline = false }

# Builtin aliases already cover the short verbs: b, ci, desc, st, op.
# Only genuinely long, genuinely daily commands get an alias here.
[aliases]
f = ["git", "fetch"]
p = ["git", "push"]
pc = ["git", "push", "--change", "@"]
pd = ["git", "push", "--dry-run"]
tug = ["bookmark", "advance", "--to", "@-"]
la = ["log", "-r", "all()"]

[[--scope]]
--when.repositories = ["~/Development/ITERAMIND"]

[--scope.user]
name = "Carlos Rosquillas"
email = "carlos@iteramind.com"
