/* Catppuccin {{ flavor | capitalize }} */

* {
  font-family: "{{ fonts.sans }}", sans-serif;
  font-size: {{ fonts.sans_size + 2 }}px;
  min-height: 0;
}

window#waybar {
  background-color: #{{ base | hex }};
  color: #{{ text | hex }};
}

#workspaces {
  background-color: #{{ surface0 | hex }};
  margin: 5px;
  padding: 0px 5px;
  border-radius: 10px;
}

#workspaces button {
  padding: 0px 15px;
  color: #{{ text | hex }};
  border-radius: 10px;
}

#workspaces button.active {
  color: #{{ base | hex }};
  background-color: #{{ primary | hex }};
}

#workspaces button:hover {
  background-color: #{{ surface1 | hex }};
  color: #{{ text | hex }};
}

#tray {
  background-color: #{{ surface0 | hex }};
  margin: 5px;
  padding: 0px 10px;
  border-radius: 10px;
}

#tray>.passive {
  -gtk-icon-effect: dim;
}

#tray>.needs-attention {
  -gtk-icon-effect: highlight;
  background-color: #{{ red | hex }};
}

#clock,
#mpris,
#wireplumber,
#privacy,
#idle_inhibitor,
#custom-timer,
#custom-weather,
#custom-powermenu {
  background-color: #{{ surface0 | hex }};
  color: #{{ text | hex }};
  padding: 0px 15px;
  margin: 5px;
  border-radius: 10px;
}

#idle_inhibitor {
  padding: 0px 10px;
}

#idle_inhibitor.activated {
  background-color: #{{ yellow | hex }};
  color: #{{ base | hex }};
}

#custom-timer {
  padding: 0 10px;
}

#custom-timer.running {
  background-color: #{{ primary | hex }};
  color: #{{ base | hex }};
}

#custom-timer.paused {
  background-color: #{{ yellow | hex }};
  color: #{{ base | hex }};
}

#custom-timer.target-reached {
  background-color: #{{ green | hex }};
  color: #{{ base | hex }};
}

#custom-timer.unavailable {
  background-color: #{{ red | hex }};
  color: #{{ base | hex }};
}

#privacy {
  background-color: #{{ red | hex }};
  color: #{{ surface0 | hex }};
}
