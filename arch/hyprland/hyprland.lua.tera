-- Generated monitor placement precedes the per-display overrides in conf.d.
local config_dir = (os.getenv("XDG_CONFIG_HOME") or os.getenv("HOME") .. "/.config") .. "/hypr"
package.path = config_dir .. "/?.lua;" .. config_dir .. "/?/init.lua;" .. package.path
require(config_dir .. "/monitors.lua")

hl.on("hyprland.start", function()
    hl.exec_cmd("app2unit -- nm-applet --indicator")
    hl.exec_cmd("hyprpm reload -n")
end)

require(config_dir .. "/conf.d/*.lua")

local accent = "{{ primary | hyprlang }}"
local secondary = "{{ secondary | hyprlang }}"
local surface0 = "{{ surface0 | hyprlang }}"
local crust = "{{ crust | hyprlang }}"

hl.config({
    general = {
        gaps_in = 3,
        gaps_out = 0,
        border_size = 2,
        col = {
            active_border = accent,
            inactive_border = surface0,
            nogroup_border_active = accent,
            nogroup_border = surface0,
        },
        resize_on_border = true,
        -- Gamescope surfaces share generic class rules across titles. Keep tearing
        -- off unless a uniquely matched test proves it safe.
        allow_tearing = false,
        layout = "dwindle",
    },
    group = {
        col = { border_active = accent, border_inactive = surface0 },
        groupbar = {
            col = { active = secondary, inactive = surface0 },
            render_titles = false,
            height = 3,
        },
    },
    decoration = {
        rounding = 10,
        active_opacity = 1.0,
        inactive_opacity = 1.0,
        shadow = { enabled = false, range = 4, render_power = 3, color = crust },
        blur = { enabled = false },
    },
    animations = { enabled = true },
    dwindle = { preserve_split = true },
    master = { new_status = "master" },
    misc = {
        force_default_wallpaper = 0,
        disable_hyprland_logo = true,
        focus_on_activate = true,
    },
    debug = { vfr = true },
    render = { new_render_scheduling = true, direct_scanout = 2 },
    input = {
        kb_layout = "us",
        kb_options = "compose:rctrl",
        follow_mouse = 1,
        mouse_refocus = false,
        sensitivity = 0,
        touchpad = { natural_scroll = false },
    },
})

hl.curve("quick", { type = "bezier", points = { { 0.15, 0 }, { 0.1, 1 } } })
hl.animation({ leaf = "windows", enabled = true, speed = 3, bezier = "quick" })
hl.animation({ leaf = "windowsIn", enabled = true, speed = 3, bezier = "quick", style = "popin 90%" })
hl.animation({ leaf = "windowsOut", enabled = true, speed = 3, bezier = "quick", style = "popin 90%" })
hl.animation({ leaf = "border", enabled = true, speed = 3, bezier = "quick" })
hl.animation({ leaf = "fade", enabled = true, speed = 3, bezier = "quick" })
hl.animation({ leaf = "workspaces", enabled = true, speed = 3, bezier = "quick" })
hl.animation({ leaf = "specialWorkspace", enabled = true, speed = 3, bezier = "quick", style = "slidefadevert -50%" })

hl.bind("SUPER + Return", hl.dsp.exec_cmd("app2unit -- kitty"))
hl.bind("SUPER + E", hl.dsp.exec_cmd("app2unit -- dolphin"))
hl.bind("SUPER + B", hl.dsp.exec_cmd("app2unit -- firefox"))
hl.bind("SUPER + W", hl.dsp.window.close())
hl.bind("SUPER + SHIFT + T", hl.dsp.group.toggle())
hl.bind("SUPER + SHIFT + F", hl.dsp.window.float({ action = "toggle" }))
hl.bind("SUPER + SHIFT + P", hl.dsp.window.pin({ action = "toggle" }))
hl.bind("SUPER + T", hl.dsp.layout("togglesplit"))

hl.bind("SUPER + bracketleft", hl.dsp.group.prev())
hl.bind("SUPER + bracketright", hl.dsp.group.next())
hl.bind("SUPER + SHIFT + bracketleft", hl.dsp.group.move_window({ forward = false }))
hl.bind("SUPER + SHIFT + bracketright", hl.dsp.group.move_window({ forward = true }))

for _, item in ipairs({ { "H", "left", -40, 0 }, { "L", "right", 40, 0 }, { "K", "up", 0, -40 }, { "J", "down", 0, 40 } }) do
    local key, direction, x, y = table.unpack(item)
    hl.bind("SUPER + SHIFT + CONTROL + " .. key, hl.dsp.window.move({ direction = direction, group_aware = true }))
    hl.bind("SUPER + " .. key, hl.dsp.focus({ direction = direction }))
    hl.bind("SUPER + SHIFT + " .. key, hl.dsp.window.move({ direction = direction }))
    hl.bind("SUPER + ALT + " .. key, hl.dsp.window.resize({ x = x, y = y, relative = true }))
end

hl.bind("SUPER + SHIFT + F12", hl.dsp.exec_cmd("~/.local/bin/skyrim-benchmark mark stall-recovered"), { locked = true })
hl.bind("F11", function()
    local window = hl.get_active_window()
    if window and window.pinned then
        hl.dispatch(hl.dsp.window.pin({ action = "off" }))
    end
    hl.dispatch(hl.dsp.window.fullscreen({ mode = "fullscreen" }))
end, { dont_inhibit = true })
hl.bind("SUPER + F", hl.dsp.window.fullscreen({ mode = "maximized" }))

hl.bind("SUPER + Z", hl.dsp.exec_cmd("app2unit -- pypr-client zoom"))
hl.bind("SUPER + mouse_down", hl.dsp.exec_cmd("app2unit -- pypr-client zoom ++0.75"))
hl.bind("SUPER + mouse_up", hl.dsp.exec_cmd("app2unit -- pypr-client zoom --0.75"))
hl.bind("SUPER + EQUAL", hl.dsp.exec_cmd("app2unit -- pypr-client zoom ++0.25"))
hl.bind("SUPER + MINUS", hl.dsp.exec_cmd("app2unit -- pypr-client zoom --0.25"))

-- Cycle through windows on the current workspace.
hl.bind("ALT + TAB", hl.dsp.window.cycle_next())
hl.bind("ALT + SHIFT + TAB", hl.dsp.window.cycle_next({ next = false }))

-- Eject the focused scratchpad window onto its monitor's regular workspace.
hl.bind("SUPER + SHIFT + ESCAPE", hl.dsp.exec_cmd("app2unit -- ~/.local/bin/hyprspace eject"))
hl.bind("SUPER + mouse:272", hl.dsp.window.drag())
hl.bind("SUPER + mouse:273", hl.dsp.window.resize())

hl.bind("XF86AudioNext", hl.dsp.exec_cmd("app2unit -- playerctl next"), { locked = true })
hl.bind("XF86AudioPause", hl.dsp.exec_cmd("app2unit -- playerctl play-pause"), { locked = true })
hl.bind("XF86AudioPlay", hl.dsp.exec_cmd("app2unit -- playerctl play-pause"), { locked = true })
hl.bind("XF86AudioPrev", hl.dsp.exec_cmd("app2unit -- playerctl previous"), { locked = true })

hl.window_rule({ name = "pinentry-focus", match = { class = "^pinentry-.*" }, stay_focused = true })
