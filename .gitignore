# Rust build artifacts
**/target/

# Generic database files (sqlite, etc.) should not be committed
*.db
/ai/opencode/catppuccin.json
/ai/pi/themes/cats.json

# Codex MCP server local env files (contain materialized secrets)
/ai/codex/mcp-servers/**/env.local

# Agent skills are centralized under /ai/agent-skills; do not re-add
# per-app copies/symlinks for shared skills.
/ai/codex/skills/
/ai/claude/skills/brain-portal
/ai/claude/skills/manage-course-notebooks
/ai/claude/skills/openviking-profiles
/ai/claude/skills/git-commit/
/ai/opencode/skills/
/ai/opencode/commands/git-commit.md
/ai/claude/commands/git-commit.md
# Installer-owned TWG CLI skills; managed by `twg skills install`, not rotz.
/ai/claude/skills/twg
/ai/claude/skills/twg-*
# Upstream Motion skill installed in ~/.agents/skills; Claude uses a local link.
/ai/claude/skills/motion

# Python bytecode caches; PYTHONPYCACHEPREFIX in tools/zsh/zshenv keeps new
# ones outside the tree.
__pycache__/
*.pyc

# Browser QA screenshots and audit logs.
/.ab-evidence/

/ai/claude/skills/karakeep-polychrome
